rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared single-operator shop jobs (live real-time sync between PC and phone without login)
    match /shop_jobs/{jobId} {
      allow read, write: if true;
    }

    match /shops/{shopId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Top-level jobs collection
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Custom stores collection
    match /custom_stores/{storeId} {
      allow read, write: if true;
    }
  }
}
